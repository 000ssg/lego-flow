<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>ssg</groupId>
    <artifactId>lego-flow</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Lego Flow — Composable Data Processing Framework (root)</name>

    <modules>
        <module>blocks</module>
        <module>service</module>
        <module>web</module>
        <module>iot</module>
        <module>auth</module>
        <!-- Protocol add-on category modules -->
        <module>messaging</module>
        <module>rpc</module>
        <module>database</module>
        <module>email</module>
        <module>network</module>
        <module>media</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <!-- Dependency versions — centralised here so child POMs stay DRY -->
        <slf4j.version>1.7.36</slf4j.version>
        <slf4j.simple.version>2.0.9</slf4j.simple.version>
        <junit.version>5.10.1</junit.version>
        <mockito.version>5.8.0</mockito.version>
        <assertj.version>3.24.2</assertj.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Lego Flow inter-module dependencies -->
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-blocks</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-http</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-web-services</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-wamp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-http2</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-http3</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-upnp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-mqtt</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-xmpp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-coap</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-ssh</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-ftp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-http-proxy</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-http-auth-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-http-auth-basic-digest</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-http-auth-oauth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-http-auth-sso</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-http-auth-spnego</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-gssapi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Messaging modules -->
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-kafka</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-amqp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-stomp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-nats</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- RPC modules -->
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-grpc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-graphql</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Database modules -->
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-postgresql</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-mysql</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Email modules -->
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-email-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-smtp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-imap</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Network modules -->
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-network-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-dns</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-ldap</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-snmp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-syslog</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-modbus</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Media modules -->
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-media-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-rtsp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-rtp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ssg</groupId>
                <artifactId>lego-flow-sip</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Logging -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>${slf4j.simple.version}</version>
            </dependency>
            <!-- Audio codec SPIs for javax.sound.sampled -->
            <dependency>
                <groupId>com.googlecode.soundlibs</groupId>
                <artifactId>mp3spi</artifactId>
                <version>1.9.5.4</version>
            </dependency>
            <dependency>
                <groupId>com.googlecode.soundlibs</groupId>
                <artifactId>tritonus-share</artifactId>
                <version>0.3.7.4</version>
            </dependency>
            <dependency>
                <groupId>org.jflac</groupId>
                <artifactId>jflac-codec</artifactId>
                <version>1.5.2</version>
            </dependency>
            <!-- Testing -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                    <configuration>
                        <fork>true</fork>
                        <parallel>classes</parallel>
                        <threadCount>4</threadCount>
                        <reuseForks>true</reuseForks>
                        <forkCount>4</forkCount>
                        <runOrder>balanced</runOrder>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.3.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                    <configuration>
                        <release>25</release>
                        <useIncrementalCompilation>false</useIncrementalCompilation>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
