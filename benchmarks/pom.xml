<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ssg</groupId>
        <artifactId>lego-flow</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>lego-flow-benchmarks</artifactId>
    <name>Lego Flow Benchmarks — Cross-module performance benchmarks (JMH)</name>

    <description>
        JMH-based microbenchmarks for protocol throughput, latency, serialization, and service pipeline overhead.
        Compares standalone protocol implementations against DP/DF service-based wrappers.
        Excluded from install/deploy lifecycle — this module is for benchmarking only.
    </description>

    <properties>
        <jmh.version>1.37</jmh.version>
    </properties>

    <dependencies>
        <!-- Core modules -->
        <dependency>
            <groupId>ssg</groupId>
            <artifactId>lego-flow-blocks</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ssg</groupId>
            <artifactId>lego-flow-sip</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ssg</groupId>
            <artifactId>lego-flow-rtp</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ssg</groupId>
            <artifactId>messaging-stomp</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ssg</groupId>
            <artifactId>lego-flow-service</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Protocol modules with service wrappers -->
        <dependency>
            <groupId>ssg</groupId>
            <artifactId>lego-flow-http</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ssg</groupId>
            <artifactId>messaging-mqtt</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ssg</groupId>
            <artifactId>lego-flow-http-auth-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ssg</groupId>
            <artifactId>lego-flow-http-auth-basic-digest</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ssg</groupId>
            <artifactId>database-redis</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ssg</groupId>
            <artifactId>network-dns</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ssg</groupId>
            <artifactId>lego-flow-smtp</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ssg</groupId>
            <artifactId>lego-flow-coap</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- JMH core -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>${jmh.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- SLF4J (required by protocol modules) -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.simple.version}</version>
        </dependency>
    </dependencies>

    <!-- Exclude from Maven install/deploy -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <version>3.1.2</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>3.1.2</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>

            <!-- JMH benchmark generation -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>org.openjdk.jmh.Main</mainClass>
                </configuration>
            </plugin>

            <!-- JMH annotation processor -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>${jmh.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Shade plugin to produce runnable benchmark JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.openjdk.jmh.Main</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
