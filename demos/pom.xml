            <groupId>ssg</groupId>
            <artifactId>lego-flow-http2</artifactId>
        </dependency>
        <dependency>
            <groupId>ssg</groupId>
            <artifactId>lego-flow-http3</artifactId>
        </dependency>
        <dependency>
            <groupId>ssg</groupId>
            <artifactId>lego-flow-web-services</artifactId>
        </dependency>
        <dependency>
            <groupId>ssg</groupId>
            <artifactId>lego-flow-http-proxy</artifactId>
        </dependency>

        <!-- Messaging modules -->
